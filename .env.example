NODE_ENV=development
PORT=3001

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

FRONTEND_URL=http://localhost:3000

COOKIE_DOMAIN=
COOKIE_SECURE=false
ACCESS_TOKEN_COOKIE_NAME=sb-access-token
REFRESH_TOKEN_COOKIE_NAME=sb-refresh-token

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional debug key for /api/status/smtp in production
STATUS_DEBUG_KEY=

# SMTP settings for forgot-password emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ZenU
SMTP_USE_TLS=true

# Optional override for password reset link base URL (defaults to FRONTEND_URL)
RESET_PASSWORD_URL_BASE=
